{
  "name": "vge-v2-phase2",
  "version": "2.0.0-alpha.2.2",
  "private": true,
  "type": "module",
  "description": "VGE v2 · motor PSC y orquestación de motores nativos",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/VGEEngine.mjs",
    "./core": "./src/core/index.mjs",
    "./native-jobs": "./src/core/native-jobs.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node tools/validate-examples.mjs",
    "example": "node examples/headless.mjs",
    "build": "node tools/build.mjs",
    "dev": "node tools/serve.mjs",
    "browser:install": "node tools/install-browser.cjs",
    "check:390": "node tools/check-390.cjs && node tools/check-block-c.cjs",
    "check:block-c": "node tools/check-block-c.cjs",
    "check:block-a": "node tools/check-block-a.cjs",
    "core:validate": "node tools/vge.mjs validate",
    "core:doctor": "node tools/vge.mjs doctor",
    "core:plan": "node tools/vge.mjs plan",
    "core:run": "node tools/vge.mjs run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.6",
    "esbuild": "0.25.12",
    "playwright": "1.64.1"
  }
